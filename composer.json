{
  "name": "blackcatacademy/blackcat-rbac",
  "description": "RBAC module for the BlackCat ecosystem (roles, user roles) on top of blackcat-database.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "psr/log": "^3.0",
    "blackcatacademy/blackcat-core": "dev-dev",
    "blackcatacademy/blackcat-database": "dev-dev"
  },
  "autoload": {
    "psr-4": {
      "BlackCat\\Rbac\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BlackCat\\Rbac\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

